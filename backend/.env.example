# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/herflow

# Authentication
JWT_SECRET=herflow_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d


# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Email Reminder Configuration (Optional/Nodemailer)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your_email@gmail.com
EMAIL_SERVER_PASSWORD=your_app_password
EMAIL_FROM="HerFlow by YourName" <noreply@herflow.app>
